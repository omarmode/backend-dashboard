<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | FARZ</title>
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body>
  <header class="topbar">
    <div>
      <p class="eyebrow">FARZ Admin</p>
      <h1>إدارة أكواد التفعيل</h1>
    </div>
    <form method="post" action="/admin/logout">
      <span class="muted">مرحباً، <%= adminUsername %></span>
      <button type="submit" class="ghost">تسجيل الخروج</button>
    </form>
  </header>

  <main class="page">
    <% if (flash) { %>
      <div class="alert <%= flash.type === 'success' ? 'alert-success' : 'alert-error' %>">
        <%= flash.text %>
      </div>
    <% } %>

    <section class="stats">
      <article><strong><%= stats.total %></strong><span>إجمالي الأكواد</span></article>
      <article><strong><%= stats.active %></strong><span>سارية ومفعلة</span></article>
      <article><strong><%= stats.blocked %></strong><span>محظورة</span></article>
      <article><strong><%= stats.expired %></strong><span>منتهية</span></article>
    </section>

    <section class="card">
      <h2>إنشاء كود تفعيل جديد</h2>
      <form method="post" action="/admin/codes" class="create-form">
        <label>
          المدة
          <input type="number" name="durationValue" min="1" value="30" required />
        </label>
        <label>
          الوحدة
          <select name="durationUnit">
            <option value="days">أيام</option>
            <option value="months">شهور</option>
          </select>
        </label>
        <button type="submit">إنشاء كود</button>
      </form>
    </section>

    <section class="card">
      <h2>قائمة الأكواد والأجهزة</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>الكود</th>
              <th>الصلاحية</th>
              <th>الحالة</th>
              <th>معرف الجهاز</th>
              <th>آخر ظهور</th>
              <th>إجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% if (!codes.length) { %>
              <tr>
                <td colspan="6" class="muted">لا توجد أكواد بعد. أنشئ كوداً من النموذج أعلاه.</td>
              </tr>
            <% } %>
            <% codes.forEach((item) => { %>
              <tr>
                <td><code><%= item.code %></code></td>
                <td>
                  <%= item.expiresAtText %>
                  <div class="muted"><%= item.durationLabel || '' %></div>
                </td>
                <td>
                  <% if (item.isBlocked) { %>
                    <span class="badge badge-red">محظور</span>
                  <% } else if (item.expired) { %>
                    <span class="badge badge-amber">منتهي</span>
                  <% } else if (item.isActivated) { %>
                    <span class="badge badge-green">مفعل</span>
                  <% } else { %>
                    <span class="badge">غير مستخدم</span>
                  <% } %>
                </td>
                <td><%= item.deviceId || '—' %></td>
                <td><%= item.lastSeenText %></td>
                <td class="actions">
                  <% if (item.isBlocked) { %>
                    <form method="post" action="/admin/codes/<%= item._id %>/unblock">
                      <button type="submit" class="ghost">إلغاء الحظر</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/admin/codes/<%= item._id %>/block">
                      <button type="submit" class="danger">حظر / تعطيل</button>
                    </form>
                  <% } %>
                  <form method="post" action="/admin/codes/<%= item._id %>/force-logout">
                    <button type="submit">طرد الجهاز</button>
                  </form>
                  <form method="post" action="/admin/codes/<%= item._id %>/delete" onsubmit="return confirm('حذف هذا الكود؟');">
                    <button type="submit" class="ghost">حذف</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
